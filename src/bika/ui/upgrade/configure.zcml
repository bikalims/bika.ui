<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="bika.ui">

 <genericsetup:upgradeStep
     title="Upgrade to BIKA.UI 1.0.1"
     description="Change workflow Dispatch to Dispose on a sample"
